# 签名配置模板。
# 复制成 keystore.properties 并填上自己的证书信息；这个文件本身不会进 Git。
#
# 生成证书：
#   keytool -genkeypair -v -keystore keystore/release.jks \
#     -alias myapp -keyalg RSA -keysize 2048 -validity 10000
#
# 没有 keystore.properties 时，release 构建会产出一个未签名的 APK（可以装不上，属于正常）。

storeFile=keystore/release.jks
storePassword=改成你的密码
keyAlias=myapp
keyPassword=改成你的密码
