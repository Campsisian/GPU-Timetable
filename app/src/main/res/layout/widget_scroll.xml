<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件：可滚动的课程列表（今日课程 / 近期课程共用）
  部件再小也能装下所有课，滑一下就能看到后面的。
  列表必须是 RemoteViews 白名单内的 ListView，数据由 WidgetService 的 RemoteViewsFactory 提供。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/wd_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wg_root_r1_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="9dp">

        <LinearLayout
            android:id="@+id/wd_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/wd_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="今天"
                android:textColor="#9EA3AA"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/wd_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textColor="#9EA3AA"
                android:textSize="10sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/wd_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@android:color/transparent"
            android:scrollbars="vertical"
            android:scrollbarStyle="insideInset"
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/wg_scrollbar"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:paddingBottom="5dp"
            android:clipToPadding="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/wd_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#9EA3AA"
        android:textSize="11sp"
        android:visibility="gone" />

</FrameLayout>
